# Production environment (docker-compose.prod.yml). Copy to .env.production, which git
# ignores, and fill in the blanks:
#   APP_KEY            "base64:" + `openssl rand -base64 32`
#   DB_PASSWORD        `openssl rand -hex 24`
#   VAPID_*            php -r "require 'vendor/autoload.php'; print_r(\Minishlink\WebPush\VAPID::createVapidKeys());"
#                      (the public key is also built into the frontend)
APP_NAME=PersonnelPlanner
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://personnelplanner.sezginyurdakul.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=personnelplanner
DB_USERNAME=personnelplanner
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=personnelplanner.sezginyurdakul.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Above GenerateScheduleSuggestion's 300 s timeout, so a running generate is never handed out twice.
REDIS_QUEUE_RETRY_AFTER=330

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sent through Resend (sezginyurdakul.com is verified there). MAIL_PASSWORD is a Resend
# API key with sending access; MAIL_MAILER=log sends nothing and only writes to the log.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@sezginyurdakul.com"
MAIL_FROM_NAME="${APP_NAME}"
# Demo accounts' made-up addresses: never mailed, so they never bounce.
MAIL_BLOCKED_DOMAINS=bakeryx.test,bakareyx.com

FRONTEND_URL=https://personnelplanner.sezginyurdakul.com
SANCTUM_STATEFUL_DOMAINS=personnelplanner.sezginyurdakul.com

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://personnelplanner.sezginyurdakul.com

PLANNER_URL=http://planner:8000
