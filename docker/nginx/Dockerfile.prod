# Production web server (docker-compose.prod.yml): the built React app, served by the same
# nginx that passes /api and /sanctum to php-fpm. Build context: ./frontend.
FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
# Read by Vite at build time; both are public values.
ARG VITE_API_BASE_URL
ARG VITE_VAPID_PUBLIC_KEY
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
